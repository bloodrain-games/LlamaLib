+//=========================== llamalib helpers ===========================//
+
+void server_context::set_enable_thinking(bool enable) {
+    if (impl) impl->chat_params.enable_thinking = enable;
+}
+
+size_t server_context::get_slots_size() const {
+    return impl ? impl->slots.size() : 0;
+}
+
+bool server_context::is_queue_empty() const {
+    return impl ? impl->queue_tasks.is_empty() : true;
+}
+
+bool server_context::is_queue_running() const {
+    return impl ? impl->queue_tasks.is_running() : false;
+}
+
+void server_context::cancel_slot(int id_slot) {
+    if (!impl) return;
+    for (auto & slot : impl->slots) {
+        if (slot.id == id_slot) {
+            slot.release();
+            break;
+        }
+    }
+}
+
+void server_context::release_all_slots() {
+    if (!impl) return;
+    for (auto & slot : impl->slots) {
+        slot.release();
+    }
+}
+
+std::string server_context::slot_action(int task_type, int id_slot, const std::string & filepath) {
+    if (!impl) return "";
+    server_task task((server_task_type)task_type);
+    task.id = impl->queue_tasks.get_new_id();
+    task.slot_action.id_slot = id_slot;
+    if (!filepath.empty()) {
+        task.slot_action.filename = filepath.substr(filepath.find_last_of("/\\") + 1);
+        task.slot_action.filepath = filepath;
+    }
+    impl->queue_results.add_waiting_task_id(task.id);
+    impl->queue_tasks.post(std::move(task));
+    server_task_result_ptr result = impl->queue_results.recv(task.id);
+    impl->queue_results.remove_waiting_task_id(task.id);
+    return result ? result->to_json().dump() : "";
+}
